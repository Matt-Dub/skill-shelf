{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the tray panel",
  "windows": [
    "panel"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/.claude/skills/**" },
        { "path": "$HOME/.agents/skills/**" }
      ]
    }
  ]
}
